---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Todo from '../components/Todo.astro';
import Value from '../components/Value.astro';
import { content } from '../i18n/content';
import { routes, type Lang } from '../i18n/routes';
import { entreprise, formspreeId } from '../config';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = content[lang].contact;
const f = c.form;
const offers = content[lang].offers.items;
const action = formspreeId ? `https://formspree.io/f/${formspreeId}` : '';
const whatsappHref = entreprise.whatsapp
  ? `https://wa.me/${entreprise.whatsapp.replace(/\D/g, '')}?text=${encodeURIComponent(c.whatsappMsg)}`
  : '';
const input = 'mt-1 block w-full rounded-md border border-navy-100 bg-white px-3 py-2.5 text-base focus:border-navy-700 focus:outline-none focus:ring-2 focus:ring-accent-500/40';
---
<Base lang={lang} routeKey="contact" title={c.title} description={c.description}>
  <PageHeader title={c.h1} lead={c.lead} />
  <section class="container-site grid gap-12 py-14 lg:grid-cols-5">
    <div class="lg:col-span-3">
      {!action && <p class="mb-6"><Todo lang={lang} label={f.notConfigured} /></p>}
      <form id="contact-form" action={action || undefined} method="POST" class="space-y-5" novalidate={false}
            data-success={f.success} data-error={f.error} data-sending={f.sending}>
        <input type="hidden" name="_language" value={lang} />
        <input type="hidden" name="_subject" value={`[Site MGE Conseil] ${lang === 'fr' ? 'Nouvelle demande' : 'New request'}`} />
        <!-- Champ piège anti-spam : doit rester vide. -->
        <div class="hidden" aria-hidden="true"><label>Ne pas remplir <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label></div>
        <div class="grid gap-5 sm:grid-cols-2">
          <label class="block text-sm font-medium">{f.name} *<input class={input} type="text" name="nom" required autocomplete="name" /></label>
          <label class="block text-sm font-medium">{f.company} *<input class={input} type="text" name="entreprise" required autocomplete="organization" /></label>
          <label class="block text-sm font-medium">{f.email} *<input class={input} type="email" name="email" required autocomplete="email" /></label>
          <label class="block text-sm font-medium">{f.phone}<input class={input} type="tel" name="telephone" autocomplete="tel" /></label>
        </div>
        <label class="block text-sm font-medium">{f.subject} *
          <select id="offre" class={input} name="objet" required>
            {offers.map((o) => <option value={o.name} data-id={o.id}>{o.name}</option>)}
            <option value={f.subjectOther} selected>{f.subjectOther}</option>
          </select>
        </label>
        <label class="block text-sm font-medium">{f.message} *<textarea class={input} name="message" rows="6" required></textarea></label>
        <label class="flex items-start gap-3 text-sm">
          <input type="checkbox" name="consentement" value="oui" required class="mt-1 h-4 w-4 accent-navy-900" />
          <span>{f.consent} <a class="underline hover:text-accent-600" href={routes.privacy[lang]}>{f.privacyLink}</a></span>
        </label>
        <button type="submit" class="btn-accent disabled:cursor-not-allowed disabled:opacity-50" disabled={!action}>{f.submit}</button>
        <p id="form-status" role="status" aria-live="polite" class="text-sm font-medium"></p>
      </form>
    </div>

    <aside class="space-y-8 lg:col-span-2">
      <div class="rounded-md bg-navy-900 p-6 text-white">
        <h2 class="text-xl font-semibold">{c.whatsappTitle}</h2>
        <p class="mt-2 text-sm text-navy-100">{c.whatsappText}</p>
        {whatsappHref
          ? <a href={whatsappHref} target="_blank" rel="noopener" class="btn mt-5 bg-[#25D366] text-navy-950 hover:bg-[#1ebe5b]">
              <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.2.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.3 2.2 2.2 0 0 0 .2-1.3c-.1-.1-.2-.2-.5-.3Z"/></svg>
              {c.whatsappBtn}
            </a>
          : <p class="mt-5"><Todo lang={lang} label={c.whatsappTodo} /></p>}
      </div>
      <div>
        <h2 class="text-xl font-semibold">{c.detailsTitle}</h2>
        <dl class="mt-4 space-y-3 text-sm">
          <div><dt class="font-semibold">{c.address}</dt>
            <dd class="text-navy-800"><Value lang={lang} value={entreprise.adresse} label={c.address} /><br />{entreprise.codePostal} {entreprise.ville}, {lang === 'fr' ? entreprise.pays : 'New Caledonia'}</dd></div>
          <div><dt class="font-semibold">{c.email}</dt>
            <dd>{entreprise.email ? <a class="underline" href={`mailto:${entreprise.email}`}>{entreprise.email}</a> : <Todo lang={lang} label={c.email} />}</dd></div>
          <div><dt class="font-semibold">{c.phone}</dt>
            <dd>{entreprise.telephone ? <a class="underline" href={`tel:${entreprise.telephone.replace(/\s/g, '')}`}>{entreprise.telephone}</a> : <Todo lang={lang} label={c.phone} />}</dd></div>
          <div><dt class="font-semibold">{c.hoursTitle}</dt><dd><Todo lang={lang} label={c.hoursTodo} /></dd></div>
        </dl>
      </div>
    </aside>
  </section>
</Base>

<script>
  // Pré-sélection de l'offre depuis le lien « Demander un devis » (?offre=…).
  const params = new URLSearchParams(location.search);
  const id = params.get('offre');
  const select = document.getElementById('offre') as HTMLSelectElement | null;
  if (id && select) {
    const opt = select.querySelector<HTMLOptionElement>(`option[data-id="${CSS.escape(id)}"]`);
    if (opt) opt.selected = true;
  }

  // Envoi sans quitter la page (sans JavaScript, le formulaire est envoyé normalement à Formspree).
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');
  form?.addEventListener('submit', async (e) => {
    if (!form.action || !status) return;
    e.preventDefault();
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    btn.disabled = true;
    status.className = 'text-sm font-medium text-navy-800';
    status.textContent = form.dataset.sending ?? '';
    try {
      const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      status.className = 'text-sm font-medium text-green-700';
      status.textContent = form.dataset.success ?? '';
    } catch {
      status.className = 'text-sm font-medium text-red-700';
      status.textContent = form.dataset.error ?? '';
    } finally {
      btn.disabled = false;
    }
  });
</script>
