---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaBand from '../components/CtaBand.astro';
import Todo from '../components/Todo.astro';
import Value from '../components/Value.astro';
import { content } from '../i18n/content';
import { entreprise } from '../config';
import type { Lang } from '../i18n/routes';
interface Props { lang: Lang }
const { lang } = Astro.props;
const a = content[lang].about;
---
<Base lang={lang} routeKey="about" title={a.title} description={a.description}>
  <PageHeader title={a.h1} lead={a.lead} />
  <section class="container-site grid gap-10 py-14 md:grid-cols-3">
    <div>
      <div class="flex aspect-[4/5] items-center justify-center rounded-md border border-dashed border-navy-100 bg-navy-50 p-4 text-center">
        <Todo lang={lang} label={a.photoTodo} />
      </div>
      <p class="mt-4 font-semibold"><Value lang={lang} value={entreprise.dirigeant} label={a.founderTitle} /></p>
    </div>
    <div class="md:col-span-2">
      <h2 class="text-2xl font-semibold">{a.pathTitle}</h2>
      <ol class="mt-8 space-y-8 border-l-2 border-navy-100 pl-6">
        {a.path.map((p) => (
          <li class="relative">
            <span aria-hidden="true" class="absolute -left-[31px] top-1.5 h-3 w-3 rounded-full bg-accent-500"></span>
            <h3 class="text-lg font-semibold">{p.t}</h3>
            <p class="mt-1 text-navy-800">{p.d}</p>
          </li>
        ))}
      </ol>
      <p class="mt-8"><Todo lang={lang} label={a.pathTodo} /></p>
    </div>
  </section>
  <section class="bg-navy-50 py-14">
    <div class="container-site">
      <h2 class="text-2xl font-semibold">{a.valuesTitle}</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {a.values.map((v) => (
          <div class="rounded-md bg-white p-6 ring-1 ring-navy-100">
            <h3 class="font-semibold">{v.t}</h3>
            <p class="mt-2 text-sm text-navy-800">{v.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  <CtaBand lang={lang} />
</Base>
