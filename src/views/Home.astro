---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import Todo from '../components/Todo.astro';
import { content } from '../i18n/content';
import { routes, type Lang } from '../i18n/routes';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = content[lang];
const h = c.home;
---
<Base lang={lang} routeKey="home" title={h.title} description={h.description} jsonLd>
  <section class="relative overflow-hidden bg-navy-900 text-white">
    <div class="container-site py-20 sm:py-28">
      <p class="text-xs font-semibold uppercase tracking-[0.25em] text-accent-500">{h.eyebrow}</p>
      <h1 class="mt-4 max-w-3xl text-4xl font-semibold leading-tight sm:text-5xl">{h.h1}</h1>
      <div class="mt-6 h-0.5 w-16 bg-accent-500"></div>
      <p class="mt-6 max-w-2xl text-lg text-navy-100">{h.lead}</p>
      <div class="mt-10 flex flex-col gap-3 sm:flex-row">
        <a href={routes.contact[lang]} class="btn-accent">{c.ui.ctaPrimary}</a>
        <a href={routes.offers[lang]} class="btn-outline-light">{c.ui.ctaOffers}</a>
      </div>
    </div>
  </section>

  <section class="container-site py-16">
    <h2 class="text-2xl font-semibold sm:text-3xl">{h.forWhoTitle}</h2>
    <ul class="mt-8 grid gap-4 md:grid-cols-3">
      {h.forWho.map((w) => <li class="border-l-2 border-accent-500 bg-navy-50 p-5 text-navy-800">{w}</li>)}
    </ul>
  </section>

  <section class="bg-navy-50 py-16">
    <div class="container-site">
      <h2 class="text-2xl font-semibold sm:text-3xl">{h.pillarsTitle}</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {h.pillars.map((p) => (
          <div class="rounded-md bg-white p-6 shadow-sm ring-1 ring-navy-100">
            <h3 class="text-lg font-semibold">{p.t}</h3>
            <p class="mt-2 text-sm text-navy-800">{p.d}</p>
          </div>
        ))}
      </div>
      <a href={routes.offers[lang]} class="btn-outline mt-10">{c.ui.ctaOffers}</a>
    </div>
  </section>

  <section class="container-site py-16">
    <h2 class="text-2xl font-semibold sm:text-3xl">{h.methodTitle}</h2>
    <ol class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {h.method.map((m, i) => (
        <li>
          <span class="font-serif text-3xl text-accent-600" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="mt-2 font-semibold">{m.t}</h3>
          <p class="mt-1 text-sm text-navy-800">{m.d}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="border-t border-navy-100 py-12">
    <div class="container-site">
      <h2 class="text-xl font-semibold">{h.refsTitle}</h2>
      <p class="mt-4"><Todo lang={lang} label={h.refsTodo} /></p>
    </div>
  </section>

  <CtaBand lang={lang} />
</Base>
