---
import { content } from '../i18n/content';
import { routes, type Lang } from '../i18n/routes';
interface Props { lang: Lang }
const { lang } = Astro.props;
const h = content[lang].home;
---
<section class="bg-navy-900 text-white">
  <div class="container-site flex flex-col items-start gap-6 py-14 md:flex-row md:items-center md:justify-between">
    <div class="max-w-2xl">
      <h2 class="text-2xl font-semibold sm:text-3xl">{h.ctaTitle}</h2>
      <p class="mt-3 text-navy-100">{h.ctaText}</p>
    </div>
    <a href={routes.contact[lang]} class="btn-accent shrink-0">{content[lang].ui.ctaPrimary}</a>
  </div>
</section>
