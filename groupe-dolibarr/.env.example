# Modèle : ne pas remplir à la main, lancer scripts/initialiser.sh qui crée .env
# avec des mots de passe forts générés aléatoirement.

# --- Accès ---
# Ordinateur local : DOMAINE=localhost, CADDY_TLS=internal, ADRESSE_ECOUTE=127.0.0.1
# VPS : DOMAINE=votre-domaine.nc, CADDY_TLS=votre@email (Let's Encrypt), ADRESSE_ECOUTE=0.0.0.0
DOMAINE=localhost
CADDY_TLS=internal
ADRESSE_ECOUTE=127.0.0.1

# --- Comptes (générés) ---
DOLI_ADMIN_LOGIN=admin
DOLI_ADMIN_PASSWORD=
MARIADB_ROOT_PASSWORD=
DB_PASSWORD_TERRAWAVES=
DB_PASSWORD_MGE=
DB_PASSWORD_HOLDING=
UNIQUE_ID_TERRAWAVES=
UNIQUE_ID_MGE=
UNIQUE_ID_HOLDING=

# --- Sauvegarde ---
# Phrase de chiffrement des sauvegardes : À RECOPIER dans un gestionnaire de mots de passe.
# Sans elle, les sauvegardes sont illisibles.
SAUVEGARDE_PHRASE=
SAUVEGARDE_JOURS_LOCAL=14
SAUVEGARDE_JOURS_DISTANT=60
# Destination rclone hors serveur, ex. "distant:dolibarr-sauvegardes" (voir docs/GUIDE.md, étape 6).
# Vide = pas de copie distante (déconseillé).
RCLONE_DESTINATION=
